{"type":"tool_use","timestamp":1781303676716,"sessionID":"ses_142079613ffeCsq2eayHwHhbpm","part":{"type":"tool","tool":"read","callID":"toolu_bdrk_01KFYe4jJyVnSCSsMYyK3hNM","state":{"status":"completed","input":{"filePath":"/home/daniel-bo/Desktop/verbal/internal/db/repository.go"},"output":"<path>/home/daniel-bo/Desktop/verbal/internal/db/repository.go</path>\n<type>file</type>\n<content>\n1: package db\n2: \n3: import (\n4: \t\"database/sql\"\n5: \t\"encoding/json\"\n6: \t\"errors\"\n7: \t\"fmt\"\n8: \t\"os\"\n9: \t\"path/filepath\"\n10: \t\"time\"\n11: \n12: \t_ \"modernc.org/sqlite\"\n13: )\n14: \n15: // Recording represents a video/audio recording in the database.\n16: type Recording struct {\n17: \tID                   int64\n18: \tFilePath             string\n19: \tDuration             time.Duration\n20: \tTranscriptionStatus  string\n21: \tTranscriptionJSON    string\n22: \tThumbnailData        string\n23: \tThumbnailMIMEType    string\n24: \tThumbnailGeneratedAt *time.Time\n25: \tCreatedAt            time.Time\n26: \tUpdatedAt            time.Time\n27: }\n28: \n29: // IsAvailable checks if the recording's media file exists on disk.\n30: func (r *Recording) IsAvailable() bool {\n31: \tif r == nil || r.FilePath == \"\" {\n32: \t\treturn false\n33: \t}\n34: \t_, err := os.Stat(r.FilePath)\n35: \treturn err == nil\n36: }\n37: \n38: // AutoSave represents the auto-saved state of a project.\n39: type AutoSave struct {\n40: \tID               int64\n41: \tProjectID        int64\n42: \tTranscriptJSON   string\n43: \tOperationsJSON   string\n44: \tPlaybackPosition int64\n45: \tSavedAt          time.Time\n46: }\n47: \n48: // AutoSaveInfo provides lightweight info about an auto-save without loading full data.\n49: type AutoSaveInfo struct {\n50: \tProjectID           int64\n51: \tSavedAt             time.Time\n52: \tHasData             bool\n53: \tTranscriptWordCount int\n54: \tPlaybackPosition    int64\n55: }\n56: \n57: // AutoSaveRepository provides CRUD operations for auto-save data.\n58: type AutoSaveRepository struct {\n59: \tdb *sql.DB\n60: }\n61: \n62: // scanner is an interface that wraps the Scan method for row scanning.\n63: // It allows scanRecording to work with both sql.Row and sql.Rows.\n64: type scanner interface {\n65: \tScan(dest ...interface{}) error\n66: }\n67: \n68: // recordingColumns is the standard SELECT column list for recording queries.\n69: const recordingColumns = `id, file_path, duration, transcription_status, transcription_json,\n70: \tthumbnail_data, thumbnail_mime_type, thumbnail_generated_at,\n71: \tcreated_at, updated_at`\n72: \n73: // scanRecording scans a single row into a Recording struct.\n74: // It handles the duration conversion and thumbnail timestamp parsing.\n75: func scanRecording(s scanner) (*Recording, error) {\n76: \trec := &Recording{}\n77: \tvar durationNS int64\n78: \tvar thumbnailGeneratedAt sql.NullString\n79: \n80: \terr := s.Scan(\n81: \t\t&rec.ID,\n82: \t\t&rec.FilePath,\n83: \t\t&durationNS,\n84: \t\t&rec.TranscriptionStatus,\n85: \t\t&rec.TranscriptionJSON,\n86: \t\t&rec.ThumbnailData,\n87: \t\t&rec.ThumbnailMIMEType,\n88: \t\t&thumbnailGeneratedAt,\n89: \t\t&rec.CreatedAt,\n90: \t\t&rec.UpdatedAt,\n91: \t)\n92: \tif err != nil {\n93: \t\treturn nil, err\n94: \t}\n95: \n96: \trec.Duration = time.Duration(durationNS)\n97: \trec.ThumbnailGeneratedAt = parseThumbnailGeneratedAt(thumbnailGeneratedAt)\n98: \treturn rec, nil\n99: }\n100: \n101: // Database wraps the SQL database connection.\n102: type Database struct {\n103: \tpath string\n104: \tdb   *sql.DB\n105: }\n106: \n107: // NewDatabase creates or opens a SQLite database at the given path.\n108: func NewDatabase(dbPath string) (*Database, error) {\n109: \tdir := filepath.Dir(dbPath)\n110: \tif err := os.MkdirAll(dir, 0755); err != nil {\n111: \t\treturn nil, fmt.Errorf(\"create database directory: %w\", err)\n112: \t}\n113: \n114: \tdb, err := sql.Open(\"sqlite\", dbPath)\n115: \tif err != nil {\n116: \t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n117: \t}\n118: \n119: \tif err := db.Ping(); err != nil {\n120: \t\treturn nil, fmt.Errorf(\"ping database: %w\", err)\n121: \t}\n122: \n123: \tif _, err := db.Exec(`PRAGMA busy_timeout = 5000`); err != nil {\n124: \t\treturn nil, fmt.Errorf(\"set busy timeout: %w\", err)\n125: \t}\n126: \tif _, err := db.Exec(`PRAGMA journal_mode = WAL`); err != nil {\n127: \t\treturn nil, fmt.Errorf(\"set journal mode: %w\", err)\n128: \t}\n129: \n130: \tdatabase := &Database{\n131: \t\tpath: dbPath,\n132: \t\tdb:   db,\n133: \t}\n134: \n135: \tif err := database.migrate(); err != nil {\n136: \t\treturn nil, fmt.Errorf(\"migrate database: %w\", err)\n137: \t}\n138: \n139: \treturn database, nil\n140: }\n141: \n142: // Close closes the database connection.\n143: func (d *Database) Close() error {\n144: \treturn d.db.Close()\n145: }\n146: \n147: // GetDBPath returns the path to the database file.\n148: func (d *Database) GetDBPath() string {\n149: \treturn d.path\n150: }\n151: \n152: // GetDB returns the underlying sql.DB connection for atomic backup operations.\n153: func (d *Database) GetDB() *sql.DB {\n154: \treturn d.db\n155: }\n156: \n157: // RecordingRepo returns a RecordingRepository for CRUD operations.\n158: func (d *Database) RecordingRepo() *RecordingRepository {\n159: \treturn &RecordingRepository{db: d.db}\n160: }\n161: \n162: // ThumbnailRepo returns a ThumbnailRepository for thumbnail operations.\n163: func (d *Database) ThumbnailRepo() *ThumbnailRepository {\n164: \treturn &ThumbnailRepository{db: d.db}\n165: }\n166: \n167: // AutoSaveRepo returns an AutoSaveRepository for auto-save operations.\n168: func (d *Database) AutoSaveRepo() *AutoSaveRepository {\n169: \treturn &AutoSaveRepository{db: d.db}\n170: }\n171: \n172: // migrate runs the versioned schema migrations.\n173: func (d *Database) migrate() error {\n174: \treturn Migrate(d.db)\n175: }\n176: \n177: // RecordingRepository provides CRUD operations for recordings.\n178: type RecordingRepository struct {\n179: \tdb *sql.DB\n180: }\n181: \n182: // Insert adds a new recording to the database and sets its ID.\n183: func (r *RecordingRepository) Insert(rec *Recording) error {\n184: \tnow := time.Now()\n185: \trec.CreatedAt = now\n186: \trec.UpdatedAt = now\n187: \n188: \tresult, err := r.db.Exec(`\n189: \t\tINSERT INTO recordings (\n190: \t\t\tfile_path, duration, transcription_status, transcription_json,\n191: \t\t\tthumbnail_data, thumbnail_mime_type, thumbnail_generated_at,\n192: \t\t\tcreated_at, updated_at\n193: \t\t)\n194: \t\tVALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n195: \t`,\n196: \t\trec.FilePath,\n197: \t\trec.Duration.Nanoseconds(),\n198: \t\trec.TranscriptionStatus,\n199: \t\trec.TranscriptionJSON,\n200: \t\trec.ThumbnailData,\n201: \t\trec.ThumbnailMIMEType,\n202: \t\tthumbnailGeneratedAtValue(rec.ThumbnailGeneratedAt),\n203: \t\trec.CreatedAt,\n204: \t\trec.UpdatedAt,\n205: \t)\n206: \tif err != nil {\n207: \t\treturn fmt.Errorf(\"insert recording: %w\", err)\n208: \t}\n209: \n210: \tid, err := result.LastInsertId()\n211: \tif err != nil {\n212: \t\treturn fmt.Errorf(\"get last insert id: %w\", err)\n213: \t}\n214: \n215: \trec.ID = id\n216: \treturn nil\n217: }\n218: \n219: // GetByID retrieves a recording by its ID.\n220: func (r *RecordingRepository) GetByID(id int64) (*Recording, error) {\n221: \trec, err := scanRecording(r.db.QueryRow(`\n222: \t\tSELECT `+recordingColumns+`\n223: \t\tFROM recordings\n224: \t\tWHERE id = ?\n225: \t`, id))\n226: \tif err != nil {\n227: \t\treturn nil, fmt.Errorf(\"get recording by id: %w\", err)\n228: \t}\n229: \treturn rec, nil\n230: }\n231: \n232: // GetByPathExact retrieves a recording by exact file path.\n233: func (r *RecordingRepository) GetByPathExact(filePath string) (*Recording, error) {\n234: \trec, err := scanRecording(r.db.QueryRow(`\n235: \t\tSELECT `+recordingColumns+`\n236: \t\tFROM recordings\n237: \t\tWHERE file_path = ?\n238: \t`, filePath))\n239: \tif err != nil {\n240: \t\treturn nil, fmt.Errorf(\"get recording by path: %w\", err)\n241: \t}\n242: \treturn rec, nil\n243: }\n244: \n245: // List returns all recordings ordered by created_at descending (newest first).\n246: func (r *RecordingRepository) List() ([]*Recording, error) {\n247: \trows, err := r.db.Query(`\n248: \t\tSELECT ` + recordingColumns + `\n249: \t\tFROM recordings\n250: \t\tORDER BY created_at DESC\n251: \t`)\n252: \tif err != nil {\n253: \t\treturn nil, fmt.Errorf(\"list recordings: %w\", err)\n254: \t}\n255: \tdefer rows.Close()\n256: \n257: \treturn scanRecordings(rows)\n258: }\n259: \n260: // scanRecordings scans multiple rows into a slice of Recording structs.\n261: func scanRecordings(rows *sql.Rows) ([]*Recording, error) {\n262: \tvar recordings []*Recording\n263: \tfor rows.Next() {\n264: \t\trec, err := scanRecording(rows)\n265: \t\tif err != nil {\n266: \t\t\treturn nil, fmt.Errorf(\"scan recording: %w\", err)\n267: \t\t}\n268: \t\trecordings = append(recordings, rec)\n269: \t}\n270: \n271: \tif err := rows.Err(); err != nil {\n272: \t\treturn nil, fmt.Errorf(\"iterate recordings: %w\", err)\n273: \t}\n274: \n275: \treturn recordings, nil\n276: }\n277: \n278: // Update modifies an existing recording in the database.\n279: func (r *RecordingRepository) Update(rec *Recording) error {\n280: \trec.UpdatedAt = time.Now()\n281: \n282: \t_, err := r.db.Exec(`\n283: \t\tUPDATE recordings\n284: \t\tSET\n285: \t\t\tfile_path = ?, duration = ?, transcription_status = ?, transcription_json = ?,\n286: \t\t\tthumbnail_data = ?, thumbnail_mime_type = ?, thumbnail_generated_at = ?,\n287: \t\t\tupdated_at = ?\n288: \t\tWHERE id = ?\n289: \t`,\n290: \t\trec.FilePath,\n291: \t\trec.Duration.Nanoseconds(),\n292: \t\trec.TranscriptionStatus,\n293: \t\trec.TranscriptionJSON,\n294: \t\trec.ThumbnailData,\n295: \t\trec.ThumbnailMIMEType,\n296: \t\tthumbnailGeneratedAtValue(rec.ThumbnailGeneratedAt),\n297: \t\trec.UpdatedAt,\n298: \t\trec.ID,\n299: \t)\n300: \tif err != nil {\n301: \t\treturn fmt.Errorf(\"update recording: %w\", err)\n302: \t}\n303: \n304: \treturn nil\n305: }\n306: \n307: // Delete removes a recording from the database.\n308: func (r *RecordingRepository) Delete(id int64) error {\n309: \t_, err := r.db.Exec(`DELETE FROM recordings WHERE id = ?`, id)\n310: \tif err != nil {\n311: \t\treturn fmt.Errorf(\"delete recording: %w\", err)\n312: \t}\n313: \n314: \treturn nil\n315: }\n316: \n317: // SearchByTranscription searches recordings by transcription content.\n318: func (r *RecordingRepository) SearchByTranscription(query string) ([]*Recording, error) {\n319: \tlikeQuery := \"%\" + query + \"%\"\n320: \n321: \trows, err := r.db.Query(`\n322: \t\tSELECT `+recordingColumns+`\n323: \t\tFROM recordings\n324: \t\tWHERE transcription_json LIKE ?\n325: \t\tORDER BY created_at DESC\n326: \t`, likeQuery)\n327: \tif err != nil {\n328: \t\treturn nil, fmt.Errorf(\"search recordings: %w\", err)\n329: \t}\n330: \tdefer rows.Close()\n331: \n332: \treturn scanRecordings(rows)\n333: }\n334: \n335: // ListRecent returns the most recent recordings up to the specified limit.\n336: func (r *RecordingRepository) ListRecent(limit int) ([]*Recording, error) {\n337: \trows, err := r.db.Query(`\n338: \t\tSELECT `+recordingColumns+`\n339: \t\tFROM recordings\n340: \t\tORDER BY created_at DESC\n341: \t\tLIMIT ?\n342: \t`, limit)\n343: \tif err != nil {\n344: \t\treturn nil, fmt.Errorf(\"list recent recordings: %w\", err)\n345: \t}\n346: \tdefer rows.Close()\n347: \n348: \treturn scanRecordings(rows)\n349: }\n350: \n351: // SearchByPath searches recordings by file path (case-insensitive LIKE search).\n352: func (r *RecordingRepository) SearchByPath(query string) ([]*Recording, error) {\n353: \tlikeQuery := \"%\" + query + \"%\"\n354: \n355: \trows, err := r.db.Query(`\n356: \t\tSELECT `+recordingColumns+`\n357: \t\tFROM recordings\n358: \t\tWHERE file_path LIKE ?\n359: \t\tORDER BY created_at DESC\n360: \t`, likeQuery)\n361: \tif err != nil {\n362: \t\treturn nil, fmt.Errorf(\"search recordings by path: %w\", err)\n363: \t}\n364: \tdefer rows.Close()\n365: \n366: \treturn scanRecordings(rows)\n367: }\n368: \n369: // UpdateOrInsert updates an existing recording or inserts a new one based on file_path.\n370: // If a recording with the same file_path exists, it updates it. Otherwise, it inserts a new record.\n371: func (r *RecordingRepository) UpdateOrInsert(rec *Recording) error {\n372: \t// Check if a recording with this file_path already exists\n373: \tvar existingID int64\n374: \terr := r.db.QueryRow(`SELECT id FROM recordings WHERE file_path = ?`, rec.FilePath).Scan(&existingID)\n375: \n376: \tif err == nil {\n377: \t\t// Recording exists, update it\n378: \t\trec.ID = existingID\n379: \t\treturn r.Update(rec)\n380: \t}\n381: \n382: \tif !errors.Is(err, sql.ErrNoRows) {\n383: \t\treturn fmt.Errorf(\"check existing recording: %w\", err)\n384: \t}\n385: \n386: \t// Recording doesn't exist, insert it\n387: \treturn r.Insert(rec)\n388: }\n389: \n390: func thumbnailGeneratedAtValue(t *time.Time) any {\n391: \tif t == nil {\n392: \t\treturn nil\n393: \t}\n394: \treturn t.UTC().Format(time.RFC3339Nano)\n395: }\n396: \n397: func parseThumbnailGeneratedAt(value sql.NullString) *time.Time {\n398: \tif !value.Valid || value.String == \"\" {\n399: \t\treturn nil\n400: \t}\n401: \n402: \tparsed, err := time.Parse(time.RFC3339Nano, value.String)\n403: \tif err != nil {\n404: \t\treturn nil\n405: \t}\n406: \tparsed = parsed.UTC()\n407: \treturn &parsed\n408: }\n409: \n410: // AutoSaveRepository provides CRUD operations for auto-save data.\n411: \n412: // autoSaveColumns is the standard SELECT column list for auto_save queries.\n413: const autoSaveColumns = `id, project_id, transcript_json, operations_json, playback_position, saved_at`\n414: \n415: // scanAutoSave scans a single row into an AutoSave struct.\n416: func scanAutoSave(s scanner) (*AutoSave, error) {\n417: \tautoSave := &AutoSave{}\n418: \tvar savedAt string\n419: \n420: \terr := s.Scan(\n421: \t\t&autoSave.ID,\n422: \t\t&autoSave.ProjectID,\n423: \t\t&autoSave.TranscriptJSON,\n424: \t\t&autoSave.OperationsJSON,\n425: \t\t&autoSave.PlaybackPosition,\n426: \t\t&savedAt,\n427: \t)\n428: \tif err != nil {\n429: \t\treturn nil, err\n430: \t}\n431: \n432: \tif savedAt != \"\" {\n433: \t\tautoSave.SavedAt, _ = time.Parse(time.RFC3339, savedAt)\n434: \t}\n435: \n436: \treturn autoSave, nil\n437: }\n438: \n439: // SaveAutoSave saves or updates auto-save data for a project.\n440: // Uses INSERT ... ON CONFLICT UPDATE to upsert.\n441: func (r *AutoSaveRepository) SaveAutoSave(as *AutoSave) error {\n442: \tas.SavedAt = time.Now()\n443: \n444: \t_, err := r.db.Exec(`\n445: \t\tINSERT INTO auto_save (project_id, transcript_json, operations_json, playback_position, saved_at)\n446: \t\tVALUES (?, ?, ?, ?, ?)\n447: \t\tON CONFLICT(project_id) DO UPDATE SET\n448: \t\t\ttranscript_json = excluded.transcript_json,\n449: \t\t\toperations_json = excluded.operations_json,\n450: \t\t\tplayback_position = excluded.playback_position,\n451: \t\t\tsaved_at = excluded.saved_at\n452: \t`,\n453: \t\tas.ProjectID,\n454: \t\tas.TranscriptJSON,\n455: \t\tas.OperationsJSON,\n456: \t\tas.PlaybackPosition,\n457: \t\tas.SavedAt,\n458: \t)\n459: \tif err != nil {\n460: \t\treturn fmt.Errorf(\"save auto_save: %w\", err)\n461: \t}\n462: \n463: \tif as.ID == 0 {\n464: \t\tvar id int64\n465: \t\terr := r.db.QueryRow(`SELECT id FROM auto_save WHERE project_id = ?`, as.ProjectID).Scan(&id)\n466: \t\tif err != nil {\n467: \t\t\treturn fmt.Errorf(\"get auto_save id: %w\", err)\n468: \t\t}\n469: \t\tas.ID = id\n470: \t}\n471: \n472: \treturn nil\n473: }\n474: \n475: // LoadAutoSave retrieves the auto-save data for a project.\n476: func (r *AutoSaveRepository) LoadAutoSave(projectID int64) (*AutoSave, error) {\n477: \tautoSave, err := scanAutoSave(r.db.QueryRow(`\n478: \t\tSELECT `+autoSaveColumns+`\n479: \t\tFROM auto_save\n480: \t\tWHERE project_id = ?\n481: \t`, projectID))\n482: \tif err != nil {\n483: \t\treturn nil, fmt.Errorf(\"load auto_save: %w\", err)\n484: \t}\n485: \treturn autoSave, nil\n486: }\n487: \n488: // HasAutoSave checks if auto-save data exists for a project.\n489: func (r *AutoSaveRepository) HasAutoSave(projectID int64) (bool, error) {\n490: \tvar exists int\n491: \terr := r.db.QueryRow(`SELECT 1 FROM auto_save WHERE project_id = ?`, projectID).Scan(&exists)\n492: \tif err == sql.ErrNoRows {\n493: \t\treturn false, nil\n494: \t}\n495: \tif err != nil {\n496: \t\treturn false, fmt.Errorf(\"has auto_save: %w\", err)\n497: \t}\n498: \treturn true, nil\n499: }\n500: \n501: // DeleteAutoSave removes auto-save data for a project.\n502: func (r *AutoSaveRepository) DeleteAutoSave(projectID int64) error {\n503: \t_, err := r.db.Exec(`DELETE FROM auto_save WHERE project_id = ?`, projectID)\n504: \tif err != nil {\n505: \t\treturn fmt.Errorf(\"delete auto_save: %w\", err)\n506: \t}\n507: \treturn nil\n508: }\n509: \n510: // GetAutoSaveInfo returns lightweight info about auto-save data without loading full transcript.\n511: func (r *AutoSaveRepository) GetAutoSaveInfo(projectID int64) (*AutoSaveInfo, error) {\n512: \tvar savedAt string\n513: \tvar transcriptJSON string\n514: \tvar playbackPosition int64\n515: \n516: \terr := r.db.QueryRow(`\n517: \t\tSELECT saved_at, transcript_json, playback_position\n518: \t\tFROM auto_save\n519: \t\tWHERE project_id = ?\n520: \t`, projectID).Scan(&savedAt, &transcriptJSON, &playbackPosition)\n521: \tif err == sql.ErrNoRows {\n522: \t\treturn nil, nil\n523: \t}\n524: \tif err != nil {\n525: \t\treturn nil, fmt.Errorf(\"get auto_save info: %w\", err)\n526: \t}\n527: \n528: \tinfo := &AutoSaveInfo{\n529: \t\tProjectID:        projectID,\n530: \t\tPlaybackPosition: playbackPosition,\n531: \t\tHasData:          transcriptJSON != \"\",\n532: \t}\n533: \n534: \tif savedAt != \"\" {\n535: \t\tinfo.SavedAt, _ = time.Parse(time.RFC3339, savedAt)\n536: \t}\n537: \n538: \tif transcriptJSON != \"\" {\n539: \t\tvar data map[string]interface{}\n540: \t\tif err := json.Unmarshal([]byte(transcriptJSON), &data); err == nil {\n541: \t\t\tif words, ok := data[\"words\"].([]interface{}); ok {\n542: \t\t\t\tinfo.TranscriptWordCount = len(words)\n543: \t\t\t}\n544: \t\t}\n545: \t}\n546: \n547: \treturn info, nil\n548: }\n\n(End of file - total 548 lines)\n</content>","metadata":{"preview":"package db\n\nimport (\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t_ \"modernc.org/sqlite\"\n)\n\n// Recording represents a video/audio recording in the database.\ntype Recording struct {\n\tID                   int64\n\tFilePath             string\n\tDuration             time.Duration\n\tTranscriptionStatus  string","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/daniel-bo/Desktop/verbal/internal/db/repository.go","text":"package db\n\nimport (\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"time\"\n\n\t_ \"modernc.org/sqlite\"\n)\n\n// Recording represents a video/audio recording in the database.\ntype Recording struct {\n\tID                   int64\n\tFilePath             string\n\tDuration             time.Duration\n\tTranscriptionStatus  string\n\tTranscriptionJSON    string\n\tThumbnailData        string\n\tThumbnailMIMEType    string\n\tThumbnailGeneratedAt *time.Time\n\tCreatedAt            time.Time\n\tUpdatedAt            time.Time\n}\n\n// IsAvailable checks if the recording's media file exists on disk.\nfunc (r *Recording) IsAvailable() bool {\n\tif r == nil || r.FilePath == \"\" {\n\t\treturn false\n\t}\n\t_, err := os.Stat(r.FilePath)\n\treturn err == nil\n}\n\n// AutoSave represents the auto-saved state of a project.\ntype AutoSave struct {\n\tID               int64\n\tProjectID        int64\n\tTranscriptJSON   string\n\tOperationsJSON   string\n\tPlaybackPosition int64\n\tSavedAt          time.Time\n}\n\n// AutoSaveInfo provides lightweight info about an auto-save without loading full data.\ntype AutoSaveInfo struct {\n\tProjectID           int64\n\tSavedAt             time.Time\n\tHasData             bool\n\tTranscriptWordCount int\n\tPlaybackPosition    int64\n}\n\n// AutoSaveRepository provides CRUD operations for auto-save data.\ntype AutoSaveRepository struct {\n\tdb *sql.DB\n}\n\n// scanner is an interface that wraps the Scan method for row scanning.\n// It allows scanRecording to work with both sql.Row and sql.Rows.\ntype scanner interface {\n\tScan(dest ...interface{}) error\n}\n\n// recordingColumns is the standard SELECT column list for recording queries.\nconst recordingColumns = `id, file_path, duration, transcription_status, transcription_json,\n\tthumbnail_data, thumbnail_mime_type, thumbnail_generated_at,\n\tcreated_at, updated_at`\n\n// scanRecording scans a single row into a Recording struct.\n// It handles the duration conversion and thumbnail timestamp parsing.\nfunc scanRecording(s scanner) (*Recording, error) {\n\trec := &Recording{}\n\tvar durationNS int64\n\tvar thumbnailGeneratedAt sql.NullString\n\n\terr := s.Scan(\n\t\t&rec.ID,\n\t\t&rec.FilePath,\n\t\t&durationNS,\n\t\t&rec.TranscriptionStatus,\n\t\t&rec.TranscriptionJSON,\n\t\t&rec.ThumbnailData,\n\t\t&rec.ThumbnailMIMEType,\n\t\t&thumbnailGeneratedAt,\n\t\t&rec.CreatedAt,\n\t\t&rec.UpdatedAt,\n\t)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\trec.Duration = time.Duration(durationNS)\n\trec.ThumbnailGeneratedAt = parseThumbnailGeneratedAt(thumbnailGeneratedAt)\n\treturn rec, nil\n}\n\n// Database wraps the SQL database connection.\ntype Database struct {\n\tpath string\n\tdb   *sql.DB\n}\n\n// NewDatabase creates or opens a SQLite database at the given path.\nfunc NewDatabase(dbPath string) (*Database, error) {\n\tdir := filepath.Dir(dbPath)\n\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\treturn nil, fmt.Errorf(\"create database directory: %w\", err)\n\t}\n\n\tdb, err := sql.Open(\"sqlite\", dbPath)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n\t}\n\n\tif err := db.Ping(); err != nil {\n\t\treturn nil, fmt.Errorf(\"ping database: %w\", err)\n\t}\n\n\tif _, err := db.Exec(`PRAGMA busy_timeout = 5000`); err != nil {\n\t\treturn nil, fmt.Errorf(\"set busy timeout: %w\", err)\n\t}\n\tif _, err := db.Exec(`PRAGMA journal_mode = WAL`); err != nil {\n\t\treturn nil, fmt.Errorf(\"set journal mode: %w\", err)\n\t}\n\n\tdatabase := &Database{\n\t\tpath: dbPath,\n\t\tdb:   db,\n\t}\n\n\tif err := database.migrate(); err != nil {\n\t\treturn nil, fmt.Errorf(\"migrate database: %w\", err)\n\t}\n\n\treturn database, nil\n}\n\n// Close closes the database connection.\nfunc (d *Database) Close() error {\n\treturn d.db.Close()\n}\n\n// GetDBPath returns the path to the database file.\nfunc (d *Database) GetDBPath() string {\n\treturn d.path\n}\n\n// GetDB returns the underlying sql.DB connection for atomic backup operations.\nfunc (d *Database) GetDB() *sql.DB {\n\treturn d.db\n}\n\n// RecordingRepo returns a RecordingRepository for CRUD operations.\nfunc (d *Database) RecordingRepo() *RecordingRepository {\n\treturn &RecordingRepository{db: d.db}\n}\n\n// ThumbnailRepo returns a ThumbnailRepository for thumbnail operations.\nfunc (d *Database) ThumbnailRepo() *ThumbnailRepository {\n\treturn &ThumbnailRepository{db: d.db}\n}\n\n// AutoSaveRepo returns an AutoSaveRepository for auto-save operations.\nfunc (d *Database) AutoSaveRepo() *AutoSaveRepository {\n\treturn &AutoSaveRepository{db: d.db}\n}\n\n// migrate runs the versioned schema migrations.\nfunc (d *Database) migrate() error {\n\treturn Migrate(d.db)\n}\n\n// RecordingRepository provides CRUD operations for recordings.\ntype RecordingRepository struct {\n\tdb *sql.DB\n}\n\n// Insert adds a new recording to the database and sets its ID.\nfunc (r *RecordingRepository) Insert(rec *Recording) error {\n\tnow := time.Now()\n\trec.CreatedAt = now\n\trec.UpdatedAt = now\n\n\tresult, err := r.db.Exec(`\n\t\tINSERT INTO recordings (\n\t\t\tfile_path, duration, transcription_status, transcription_json,\n\t\t\tthumbnail_data, thumbnail_mime_type, thumbnail_generated_at,\n\t\t\tcreated_at, updated_at\n\t\t)\n\t\tVALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n\t`,\n\t\trec.FilePath,\n\t\trec.Duration.Nanoseconds(),\n\t\trec.TranscriptionStatus,\n\t\trec.TranscriptionJSON,\n\t\trec.ThumbnailData,\n\t\trec.ThumbnailMIMEType,\n\t\tthumbnailGeneratedAtValue(rec.ThumbnailGeneratedAt),\n\t\trec.CreatedAt,\n\t\trec.UpdatedAt,\n\t)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"insert recording: %w\", err)\n\t}\n\n\tid, err := result.LastInsertId()\n\tif err != nil {\n\t\treturn fmt.Errorf(\"get last insert id: %w\", err)\n\t}\n\n\trec.ID = id\n\treturn nil\n}\n\n// GetByID retrieves a recording by its ID.\nfunc (r *RecordingRepository) GetByID(id int64) (*Recording, error) {\n\trec, err := scanRecording(r.db.QueryRow(`\n\t\tSELECT `+recordingColumns+`\n\t\tFROM recordings\n\t\tWHERE id = ?\n\t`, id))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"get recording by id: %w\", err)\n\t}\n\treturn rec, nil\n}\n\n// GetByPathExact retrieves a recording by exact file path.\nfunc (r *RecordingRepository) GetByPathExact(filePath string) (*Recording, error) {\n\trec, err := scanRecording(r.db.QueryRow(`\n\t\tSELECT `+recordingColumns+`\n\t\tFROM recordings\n\t\tWHERE file_path = ?\n\t`, filePath))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"get recording by path: %w\", err)\n\t}\n\treturn rec, nil\n}\n\n// List returns all recordings ordered by created_at descending (newest first).\nfunc (r *RecordingRepository) List() ([]*Recording, error) {\n\trows, err := r.db.Query(`\n\t\tSELECT ` + recordingColumns + `\n\t\tFROM recordings\n\t\tORDER BY created_at DESC\n\t`)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"list recordings: %w\", err)\n\t}\n\tdefer rows.Close()\n\n\treturn scanRecordings(rows)\n}\n\n// scanRecordings scans multiple rows into a slice of Recording structs.\nfunc scanRecordings(rows *sql.Rows) ([]*Recording, error) {\n\tvar recordings []*Recording\n\tfor rows.Next() {\n\t\trec, err := scanRecording(rows)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"scan recording: %w\", err)\n\t\t}\n\t\trecordings = append(recordings, rec)\n\t}\n\n\tif err := rows.Err(); err != nil {\n\t\treturn nil, fmt.Errorf(\"iterate recordings: %w\", err)\n\t}\n\n\treturn recordings, nil\n}\n\n// Update modifies an existing recording in the database.\nfunc (r *RecordingRepository) Update(rec *Recording) error {\n\trec.UpdatedAt = time.Now()\n\n\t_, err := r.db.Exec(`\n\t\tUPDATE recordings\n\t\tSET\n\t\t\tfile_path = ?, duration = ?, transcription_status = ?, transcription_json = ?,\n\t\t\tthumbnail_data = ?, thumbnail_mime_type = ?, thumbnail_generated_at = ?,\n\t\t\tupdated_at = ?\n\t\tWHERE id = ?\n\t`,\n\t\trec.FilePath,\n\t\trec.Duration.Nanoseconds(),\n\t\trec.TranscriptionStatus,\n\t\trec.TranscriptionJSON,\n\t\trec.ThumbnailData,\n\t\trec.ThumbnailMIMEType,\n\t\tthumbnailGeneratedAtValue(rec.ThumbnailGeneratedAt),\n\t\trec.UpdatedAt,\n\t\trec.ID,\n\t)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"update recording: %w\", err)\n\t}\n\n\treturn nil\n}\n\n// Delete removes a recording from the database.\nfunc (r *RecordingRepository) Delete(id int64) error {\n\t_, err := r.db.Exec(`DELETE FROM recordings WHERE id = ?`, id)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"delete recording: %w\", err)\n\t}\n\n\treturn nil\n}\n\n// SearchByTranscription searches recordings by transcription content.\nfunc (r *RecordingRepository) SearchByTranscription(query string) ([]*Recording, error) {\n\tlikeQuery := \"%\" + query + \"%\"\n\n\trows, err := r.db.Query(`\n\t\tSELECT `+recordingColumns+`\n\t\tFROM recordings\n\t\tWHERE transcription_json LIKE ?\n\t\tORDER BY created_at DESC\n\t`, likeQuery)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"search recordings: %w\", err)\n\t}\n\tdefer rows.Close()\n\n\treturn scanRecordings(rows)\n}\n\n// ListRecent returns the most recent recordings up to the specified limit.\nfunc (r *RecordingRepository) ListRecent(limit int) ([]*Recording, error) {\n\trows, err := r.db.Query(`\n\t\tSELECT `+recordingColumns+`\n\t\tFROM recordings\n\t\tORDER BY created_at DESC\n\t\tLIMIT ?\n\t`, limit)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"list recent recordings: %w\", err)\n\t}\n\tdefer rows.Close()\n\n\treturn scanRecordings(rows)\n}\n\n// SearchByPath searches recordings by file path (case-insensitive LIKE search).\nfunc (r *RecordingRepository) SearchByPath(query string) ([]*Recording, error) {\n\tlikeQuery := \"%\" + query + \"%\"\n\n\trows, err := r.db.Query(`\n\t\tSELECT `+recordingColumns+`\n\t\tFROM recordings\n\t\tWHERE file_path LIKE ?\n\t\tORDER BY created_at DESC\n\t`, likeQuery)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"search recordings by path: %w\", err)\n\t}\n\tdefer rows.Close()\n\n\treturn scanRecordings(rows)\n}\n\n// UpdateOrInsert updates an existing recording or inserts a new one based on file_path.\n// If a recording with the same file_path exists, it updates it. Otherwise, it inserts a new record.\nfunc (r *RecordingRepository) UpdateOrInsert(rec *Recording) error {\n\t// Check if a recording with this file_path already exists\n\tvar existingID int64\n\terr := r.db.QueryRow(`SELECT id FROM recordings WHERE file_path = ?`, rec.FilePath).Scan(&existingID)\n\n\tif err == nil {\n\t\t// Recording exists, update it\n\t\trec.ID = existingID\n\t\treturn r.Update(rec)\n\t}\n\n\tif !errors.Is(err, sql.ErrNoRows) {\n\t\treturn fmt.Errorf(\"check existing recording: %w\", err)\n\t}\n\n\t// Recording doesn't exist, insert it\n\treturn r.Insert(rec)\n}\n\nfunc thumbnailGeneratedAtValue(t *time.Time) any {\n\tif t == nil {\n\t\treturn nil\n\t}\n\treturn t.UTC().Format(time.RFC3339Nano)\n}\n\nfunc parseThumbnailGeneratedAt(value sql.NullString) *time.Time {\n\tif !value.Valid || value.String == \"\" {\n\t\treturn nil\n\t}\n\n\tparsed, err := time.Parse(time.RFC3339Nano, value.String)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tparsed = parsed.UTC()\n\treturn &parsed\n}\n\n// AutoSaveRepository provides CRUD operations for auto-save data.\n\n// autoSaveColumns is the standard SELECT column list for auto_save queries.\nconst autoSaveColumns = `id, project_id, transcript_json, operations_json, playback_position, saved_at`\n\n// scanAutoSave scans a single row into an AutoSave struct.\nfunc scanAutoSave(s scanner) (*AutoSave, error) {\n\tautoSave := &AutoSave{}\n\tvar savedAt string\n\n\terr := s.Scan(\n\t\t&autoSave.ID,\n\t\t&autoSave.ProjectID,\n\t\t&autoSave.TranscriptJSON,\n\t\t&autoSave.OperationsJSON,\n\t\t&autoSave.PlaybackPosition,\n\t\t&savedAt,\n\t)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tif savedAt != \"\" {\n\t\tautoSave.SavedAt, _ = time.Parse(time.RFC3339, savedAt)\n\t}\n\n\treturn autoSave, nil\n}\n\n// SaveAutoSave saves or updates auto-save data for a project.\n// Uses INSERT ... ON CONFLICT UPDATE to upsert.\nfunc (r *AutoSaveRepository) SaveAutoSave(as *AutoSave) error {\n\tas.SavedAt = time.Now()\n\n\t_, err := r.db.Exec(`\n\t\tINSERT INTO auto_save (project_id, transcript_json, operations_json, playback_position, saved_at)\n\t\tVALUES (?, ?, ?, ?, ?)\n\t\tON CONFLICT(project_id) DO UPDATE SET\n\t\t\ttranscript_json = excluded.transcript_json,\n\t\t\toperations_json = excluded.operations_json,\n\t\t\tplayback_position = excluded.playback_position,\n\t\t\tsaved_at = excluded.saved_at\n\t`,\n\t\tas.ProjectID,\n\t\tas.TranscriptJSON,\n\t\tas.OperationsJSON,\n\t\tas.PlaybackPosition,\n\t\tas.SavedAt,\n\t)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"save auto_save: %w\", err)\n\t}\n\n\tif as.ID == 0 {\n\t\tvar id int64\n\t\terr := r.db.QueryRow(`SELECT id FROM auto_save WHERE project_id = ?`, as.ProjectID).Scan(&id)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"get auto_save id: %w\", err)\n\t\t}\n\t\tas.ID = id\n\t}\n\n\treturn nil\n}\n\n// LoadAutoSave retrieves the auto-save data for a project.\nfunc (r *AutoSaveRepository) LoadAutoSave(projectID int64) (*AutoSave, error) {\n\tautoSave, err := scanAutoSave(r.db.QueryRow(`\n\t\tSELECT `+autoSaveColumns+`\n\t\tFROM auto_save\n\t\tWHERE project_id = ?\n\t`, projectID))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"load auto_save: %w\", err)\n\t}\n\treturn autoSave, nil\n}\n\n// HasAutoSave checks if auto-save data exists for a project.\nfunc (r *AutoSaveRepository) HasAutoSave(projectID int64) (bool, error) {\n\tvar exists int\n\terr := r.db.QueryRow(`SELECT 1 FROM auto_save WHERE project_id = ?`, projectID).Scan(&exists)\n\tif err == sql.ErrNoRows {\n\t\treturn false, nil\n\t}\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"has auto_save: %w\", err)\n\t}\n\treturn true, nil\n}\n\n// DeleteAutoSave removes auto-save data for a project.\nfunc (r *AutoSaveRepository) DeleteAutoSave(projectID int64) error {\n\t_, err := r.db.Exec(`DELETE FROM auto_save WHERE project_id = ?`, projectID)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"delete auto_save: %w\", err)\n\t}\n\treturn nil\n}\n\n// GetAutoSaveInfo returns lightweight info about auto-save data without loading full transcript.\nfunc (r *AutoSaveRepository) GetAutoSaveInfo(projectID int64) (*AutoSaveInfo, error) {\n\tvar savedAt string\n\tvar transcriptJSON string\n\tvar playbackPosition int64\n\n\terr := r.db.QueryRow(`\n\t\tSELECT saved_at, transcript_json, playback_position\n\t\tFROM auto_save\n\t\tWHERE project_id = ?\n\t`, projectID).Scan(&savedAt, &transcriptJSON, &playbackPosition)\n\tif err == sql.ErrNoRows {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"get auto_save info: %w\", err)\n\t}\n\n\tinfo := &AutoSaveInfo{\n\t\tProjectID:        projectID,\n\t\tPlaybackPosition: playbackPosition,\n\t\tHasData:          transcriptJSON != \"\",\n\t}\n\n\tif savedAt != \"\" {\n\t\tinfo.SavedAt, _ = time.Parse(time.RFC3339, savedAt)\n\t}\n\n\tif transcriptJSON != \"\" {\n\t\tvar data map[string]interface{}\n\t\tif err := json.Unmarshal([]byte(transcriptJSON), &data); err == nil {\n\t\t\tif words, ok := data[\"words\"].([]interface{}); ok {\n\t\t\t\tinfo.TranscriptWordCount = len(words)\n\t\t\t}\n\t\t}\n\t}\n\n\treturn info, nil\n}","lineStart":1,"lineEnd":548,"totalLines":548,"truncated":false}},"title":"internal/db/repository.go","time":{"start":1781303676574,"end":1781303676657}},"id":"prt_ebdf90ad2001em0cAFFMhBnPuL","sessionID":"ses_142079613ffeCsq2eayHwHhbpm","messageID":"msg_ebdf8e8d20011d0QN81SPXQAZp"}}
