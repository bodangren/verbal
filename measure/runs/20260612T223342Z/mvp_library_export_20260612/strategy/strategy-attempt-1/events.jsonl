{"type":"tool_use","timestamp":1781303677241,"sessionID":"ses_142079613ffeCsq2eayHwHhbpm","part":{"type":"tool","tool":"read","callID":"toolu_bdrk_014cyo6B9gXSdb2noTjvCeKL","state":{"status":"completed","input":{"filePath":"/home/daniel-bo/Desktop/verbal/internal/lifecycle/exporter.go"},"output":"<path>/home/daniel-bo/Desktop/verbal/internal/lifecycle/exporter.go</path>\n<type>file</type>\n<content>\n1: package lifecycle\n2: \n3: import (\n4: \t\"archive/zip\"\n5: \t\"context\"\n6: \t\"fmt\"\n7: \t\"os\"\n8: \t\"path/filepath\"\n9: \t\"time\"\n10: )\n11: \n12: // ProgressCallback is called during export operations to report progress.\n13: type ProgressCallback func(percent int, message string)\n14: \n15: // Exporter defines the interface for exporting recordings.\n16: type Exporter interface {\n17: \t// Export exports a single recording by ID to the specified destination.\n18: \tExport(ctx context.Context, recordingID string, destPath string, progress ProgressCallback) error\n19: \n20: \t// ExportAll exports all recordings to the specified destination.\n21: \tExportAll(ctx context.Context, destPath string, progress ProgressCallback) error\n22: }\n23: \n24: // ArchiveExporter implements Exporter using ZIP archives.\n25: type ArchiveExporter struct {\n26: \trecordingProvider RecordingProvider\n27: \tfileProvider      FileProvider\n28: }\n29: \n30: // RecordingProvider retrieves recording metadata for export.\n31: type RecordingProvider interface {\n32: \tGetByID(ctx context.Context, id string) (*ExportableRecording, error)\n33: \tGetAll(ctx context.Context) ([]*ExportableRecording, error)\n34: }\n35: \n36: // FileProvider reads file data for export.\n37: type FileProvider interface {\n38: \tReadFile(path string) ([]byte, error)\n39: \tFileSize(path string) (int64, error)\n40: }\n41: \n42: // ExportableRecording represents a recording ready for export.\n43: type ExportableRecording struct {\n44: \tID                string\n45: \tTitle             string\n46: \tDescription       string\n47: \tCreatedAt         int64 // Unix timestamp in milliseconds\n48: \tDuration          int64 // Duration in milliseconds\n49: \tMediaPath         string\n50: \tTranscriptionPath string\n51: \tThumbnailPath     string\n52: }\n53: \n54: // NewArchiveExporter creates a new ArchiveExporter.\n55: func NewArchiveExporter(recordingProvider RecordingProvider, fileProvider FileProvider) *ArchiveExporter {\n56: \treturn &ArchiveExporter{\n57: \t\trecordingProvider: recordingProvider,\n58: \t\tfileProvider:      fileProvider,\n59: \t}\n60: }\n61: \n62: // Export exports a single recording as a ZIP archive.\n63: func (e *ArchiveExporter) Export(ctx context.Context, recordingID string, destPath string, progress ProgressCallback) error {\n64: \tif progress == nil {\n65: \t\tprogress = func(int, string) {}\n66: \t}\n67: \n68: \tprogress(0, \"Fetching recording metadata...\")\n69: \n70: \trecording, err := e.recordingProvider.GetByID(ctx, recordingID)\n71: \tif err != nil {\n72: \t\treturn fmt.Errorf(\"failed to get recording: %w\", err)\n73: \t}\n74: \n75: \tprogress(10, \"Preparing export...\")\n76: \n77: \t// Create ZIP archive\n78: \tzipFile, err := os.Create(destPath)\n79: \tif err != nil {\n80: \t\treturn fmt.Errorf(\"failed to create archive: %w\", err)\n81: \t}\n82: \tdefer zipFile.Close()\n83: \n84: \tzipWriter := zip.NewWriter(zipFile)\n85: \tdefer zipWriter.Close()\n86: \n87: \t// Build exported recording structure\n88: \texportedRec := &ExportedRecording{\n89: \t\tID:          recording.ID,\n90: \t\tTitle:       recording.Title,\n91: \t\tDescription: recording.Description,\n92: \t\tCreatedAt:   int64ToTime(recording.CreatedAt),\n93: \t\tDuration:    recording.Duration,\n94: \t}\n95: \n96: \t// Add media file\n97: \tprogress(20, \"Adding media file...\")\n98: \tmediaFile, err := e.addFileToArchive(zipWriter, recording.MediaPath, \"media/\")\n99: \tif err != nil {\n100: \t\treturn fmt.Errorf(\"failed to add media file: %w\", err)\n101: \t}\n102: \texportedRec.MediaFile = mediaFile\n103: \n104: \t// Add transcription if available\n105: \tif recording.TranscriptionPath != \"\" {\n106: \t\tprogress(50, \"Adding transcription...\")\n107: \t\ttransFile, err := e.addFileToArchive(zipWriter, recording.TranscriptionPath, \"transcription/\")\n108: \t\tif err != nil {\n109: \t\t\treturn fmt.Errorf(\"failed to add transcription: %w\", err)\n110: \t\t}\n111: \t\texportedRec.Transcription = transFile\n112: \t}\n113: \n114: \t// Add thumbnail if available\n115: \tif recording.ThumbnailPath != \"\" {\n116: \t\tprogress(75, \"Adding thumbnail...\")\n117: \t\tthumbFile, err := e.addFileToArchive(zipWriter, recording.ThumbnailPath, \"thumbnail/\")\n118: \t\tif err != nil {\n119: \t\t\treturn fmt.Errorf(\"failed to add thumbnail: %w\", err)\n120: \t\t}\n121: \t\texportedRec.Thumbnail = thumbFile\n122: \t}\n123: \n124: \t// Create and add manifest\n125: \tprogress(90, \"Creating manifest...\")\n126: \tmanifest := NewExportManifest(exportedRec)\n127: \tmanifestData, err := manifest.Serialize()\n128: \tif err != nil {\n129: \t\treturn fmt.Errorf(\"failed to serialize manifest: %w\", err)\n130: \t}\n131: \n132: \tmanifestWriter, err := zipWriter.Create(\"manifest.json\")\n133: \tif err != nil {\n134: \t\treturn fmt.Errorf(\"failed to create manifest in archive: %w\", err)\n135: \t}\n136: \n137: \tif _, err := manifestWriter.Write(manifestData); err != nil {\n138: \t\treturn fmt.Errorf(\"failed to write manifest: %w\", err)\n139: \t}\n140: \n141: \tprogress(100, \"Export complete\")\n142: \treturn nil\n143: }\n144: \n145: // ExportAll exports all recordings as a single ZIP archive.\n146: func (e *ArchiveExporter) ExportAll(ctx context.Context, destPath string, progress ProgressCallback) error {\n147: \tif progress == nil {\n148: \t\tprogress = func(int, string) {}\n149: \t}\n150: \n151: \tprogress(0, \"Fetching all recordings...\")\n152: \n153: \trecordings, err := e.recordingProvider.GetAll(ctx)\n154: \tif err != nil {\n155: \t\treturn fmt.Errorf(\"failed to get recordings: %w\", err)\n156: \t}\n157: \n158: \tif len(recordings) == 0 {\n159: \t\treturn fmt.Errorf(\"no recordings to export\")\n160: \t}\n161: \n162: \tprogress(5, fmt.Sprintf(\"Found %d recordings\", len(recordings)))\n163: \n164: \t// Create ZIP archive\n165: \tzipFile, err := os.Create(destPath)\n166: \tif err != nil {\n167: \t\treturn fmt.Errorf(\"failed to create archive: %w\", err)\n168: \t}\n169: \tdefer zipFile.Close()\n170: \n171: \tzipWriter := zip.NewWriter(zipFile)\n172: \tdefer zipWriter.Close()\n173: \n174: \texportedRecordings := make([]*ExportedRecording, 0, len(recordings))\n175: \n176: \tfor i, recording := range recordings {\n177: \t\tbaseProgress := 5 + (i * 90 / len(recordings))\n178: \t\tprogress(baseProgress, fmt.Sprintf(\"Exporting recording %d of %d: %s\", i+1, len(recordings), recording.Title))\n179: \n180: \t\texportedRec := &ExportedRecording{\n181: \t\t\tID:          recording.ID,\n182: \t\t\tTitle:       recording.Title,\n183: \t\t\tDescription: recording.Description,\n184: \t\t\tCreatedAt:   int64ToTime(recording.CreatedAt),\n185: \t\t\tDuration:    recording.Duration,\n186: \t\t}\n187: \n188: \t\t// Add files with recording-specific prefixes\n189: \t\tprefix := fmt.Sprintf(\"recordings/%s/\", recording.ID)\n190: \n191: \t\t// Media file\n192: \t\tmediaFile, err := e.addFileToArchive(zipWriter, recording.MediaPath, prefix+\"media/\")\n193: \t\tif err != nil {\n194: \t\t\treturn fmt.Errorf(\"failed to add media file for %s: %w\", recording.ID, err)\n195: \t\t}\n196: \t\texportedRec.MediaFile = mediaFile\n197: \n198: \t\t// Transcription\n199: \t\tif recording.TranscriptionPath != \"\" {\n200: \t\t\ttransFile, err := e.addFileToArchive(zipWriter, recording.TranscriptionPath, prefix+\"transcription/\")\n201: \t\t\tif err != nil {\n202: \t\t\t\treturn fmt.Errorf(\"failed to add transcription for %s: %w\", recording.ID, err)\n203: \t\t\t}\n204: \t\t\texportedRec.Transcription = transFile\n205: \t\t}\n206: \n2